  "topic_id": "math_py_sub_5",
  "name": "5以内的减法",
  "subject": "math",
  "grade": "一年级上",
  "content": {
    "教学主题": "5以内的减法",
    "适用年级": "小学一年级上学期",
    "教学目标": "认识减法符号，理解减法的含义，能正确计算5以内的减法",
    "教学内容": [
      {
        "章节": "一、认识减法",
        "内容": "减法就是把一部分拿走，求还剩多少。我们用一个可爱的符号来表示它：−（减号）。读作\"减\"。",
        "举例": "比如你有5个苹果，吃了2个，还剩几个？就用减法：5 − 2 = 3"
      },
      {
        "章节": "二、学习5以内的减法",
        "内容": "我们可以通过数手指、画图、摆小棒的方法来算减法哦！",
        "举例": [
          "例子1：有4只小鸟，飞走了1只，还剩几只？算式：4 − 1 = 3",
          "例子2：有5颗糖果，吃掉了2颗，还剩几颗？算式：5 − 2 = 3",
          "例子3：有3朵花，摘了1朵，还剩几朵？算式：3 − 1 = 2"
        ]
      },
      {
        "章节": "三、小提示",
        "内容": "① 从大数开始数，减去几就往前数几；② 减掉0，还是原来的数；③ 一个数减去自己，结果是0。"
      }
    ],
    "练习题": [
      {
        "题目": "5 − 2 = ?",
        "选项": [
          "A. 2",
          "B. 3",
          "C. 4"
        ],
        "答案": "B",
        "解析": "5 − 2 = 3，可以伸出5根手指，弯下2根，还剩3根。"
      },
      {
        "题目": "3 − 1 = ?",
        "选项": [
          "A. 1",
          "B. 2",
          "C. 3"
        ],
        "答案": "B",
        "解析": "3 − 1 = 2，从3里面拿走1，还剩2。"
      },
      {
        "题目": "4 − 4 = ?",
        "选项": [
          "A. 4",
          "B. 2",
          "C. 0"
        ],
        "答案": "C",
        "解析": "一个数减去自己，结果是0，所以4 − 4 = 0。"
      }
    ]
  },
