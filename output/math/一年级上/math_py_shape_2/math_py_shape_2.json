      {
        "section": "什么是正方体？",
        "text": "正方体是一个由6个完全相同的正方形面组成的立体图形。它的每个面都是正方形，而且6个面的大小完全一样。"
      },
      {
        "section": "正方体的特点",
        "points": [
          "有6个面，每个面都是正方形",
          "有12条棱，每条棱的长度都相等",
          "有8个顶点（角）"
        ]
      },
      {
        "section": "生活中的正方体",
        "examples": [
          "骰子（玩具小方块）",
          "魔方",
          "一些积木块",
          "纸巾盒（有些是正方体）",
          "方糖"
        ]
      }
    ],
    "quiz": [
      {
        "question": "正方体有几个面？",
        "options": [
          "A. 4个",
          "B. 6个",
          "C. 8个",
          "D. 12个"
        ],
        "answer": "B",
        "explanation": "正方体有6个面，每个面都是正方形。"
      },
      {
        "question": "下面哪个物品是正方体？",
        "options": [
          "A. 篮球",
          "B. 牙膏盒",
          "C. 魔方",
          "D. 硬币"
        ],
        "answer": "C",
        "explanation": "魔方的形状是正方体，它有6个完全相同的正方形面。"
      },
      {
        "question": "正方体的每个面是什么形状？",
        "options": [
          "A. 圆形",
          "B. 三角形",
          "C. 正方形",
          "D. 长方形"
        ],
        "answer": "C",
        "explanation": "正方体的每个面都是正方形，6个面的大小完全一样。"
      }
    ]
  }
